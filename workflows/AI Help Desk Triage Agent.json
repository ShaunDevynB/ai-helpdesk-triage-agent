    {
      "parameters": {
        "jsCode": "// 1. Grab the AI's answer text\nconst aiOutput = $input.first().json;\nconst raw = aiOutput.text ?? aiOutput.output ?? '';\n\n// 2. Grab the original ticket details from the form\nconst form = $('On form submission').first().json;\nconst ticket = {\n  name: form['Your Name'],\n  email: form['Your Email'],\n  issue: form['Describe Your Issue'],\n};\n\n// 3. Try to read the AI's answer as JSON\nlet result;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  result = JSON.parse(cleaned);\n} catch (error) {\n  // If the answer isn't valid JSON, flag it for a human\n  return [{\n    json: {\n      ...ticket,\n      valid: false,\n      needs_human_review: true,\n      problems: ['AI did not return valid JSON'],\n      raw_ai_output: raw,\n    },\n  }];\n}\n\n// 4. Check each field against what we allow\nconst allowedCategories = ['Account Access', 'Hardware', 'Software', 'Network', 'Security Incident', 'Other'];\nconst allowedPriorities = ['Low', 'Medium', 'High', 'Critical'];\nconst problems = [];\n\nif (!allowedCategories.includes(result.category)) problems.push('Unexpected category');\nif (!allowedPriorities.includes(result.priority)) problems.push('Unexpected priority');\nif (typeof result.summary !== 'string' || result.summary.length === 0) problems.push('Missing summary');\nif (typeof result.needs_human_review !== 'boolean') problems.push('needs_human_review is not true/false');\n\n// 5. Safety rule: a problem, a risky ticket, or the AI's own doubt means a human reviews it\nconst mustReview =\n  problems.length > 0 ||\n  result.needs_human_review === true ||\n  result.category === 'Security Incident' ||\n  result.priority === 'Critical';\n\n// 6. Send the cleaned-up result to the next step\nreturn [{\n  json: {\n    ...ticket,\n    ...result,\n    valid: problems.length === 0,\n    problems,\n    needs_human_review: mustReview,\n  },\n}];"
      },
